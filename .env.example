# Copy to .env and export these before `npm start`. All are optional.
GITHUB_TOKEN=            # raises the GitHub rate limit and allows private repos
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=          # https://id.atlassian.com/manage-profile/security/api-tokens
SLACK_WEBHOOK_URL=       # incoming webhook for the go/no-go summary
PUBLIC_URL=              # link included in Slack messages
PORT=3000
